{
  "version": 2,
  "cleanUrls": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/_expo/(.*)", "dest": "/_expo/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/metadata.json", "dest": "/metadata.json" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
